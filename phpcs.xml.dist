<?xml version="1.0"?>
<ruleset name="CoderEmbassy Bulk Variations Manager">
	<description>PHPCS for CoderEmbassy Bulk Variations Manager for WooCommerce</description>

	<file>coderembassy-bulk-variations-manager.php</file>
	<file>uninstall.php</file>
	<file>src</file>
	<file>tests</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/assets/admin/dist/*</exclude-pattern>
	<exclude-pattern>*/src/Vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/stubs/*</exclude-pattern>

	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<config name="minimum_supported_wp_version" value="6.3"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="coderembassy-bulk-variations-manager"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="coderembassy_bulk_variations_manager"/>
				<element value="bv"/>
			</property>
		</properties>
		<exclude-pattern>coderembassy-bulk-variations-manager\.php</exclude-pattern>
		<exclude-pattern>uninstall\.php</exclude-pattern>
		<exclude-pattern>phpstan-bootstrap\.php</exclude-pattern>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.DB.SlowDBQuery">
		<exclude-pattern>/tests/*</exclude-pattern>
		<exclude-pattern>tests/*</exclude-pattern>
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!-- PROMPT pack uses camelCase API names on contracts and services. -->
	<rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
		<exclude-pattern>*/src/Contracts/*</exclude-pattern>
		<exclude-pattern>*/src/Repository/JobRepository.php</exclude-pattern>
		<exclude-pattern>*/src/Services/HistoryLogger.php</exclude-pattern>
		<exclude-pattern>*/src/Jobs/JobManager.php</exclude-pattern>
		<exclude-pattern>*/src/Engine/BulkEditor.php</exclude-pattern>
	</rule>

	<arg value="ps"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
</ruleset>
