{
	"name": "coderembassy/bulk-variations-manager",
	"description": "CoderEmbassy Bulk Variations Manager for WooCommerce",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1",
		"lucatume/di52": "^3.3",
		"woocommerce/action-scheduler": "^3.7"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"brain/monkey": "^2.6",
		"10up/wp_mock": "^0.5",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"wp-coding-standards/wpcs": "^3.1",
		"automattic/vipwpcs": "^3.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"BulkVariations\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"BulkVariations\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": [
			"@test:unit"
		],
		"test:unit": "phpunit --configuration phpunit.xml.dist --testsuite unit",
		"test:integration": "phpunit --configuration phpunit.xml.dist --testsuite integration",
		"lint:php": "phpcs",
		"lint:fix": "phpcbf",
		"phpstan": "phpstan analyse --configuration=phpstan.neon.dist",
		"build-free": "echo 'Strauss build: configure composer-strauss.json and run strauss in CI (PROMPT 02+).'"
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
